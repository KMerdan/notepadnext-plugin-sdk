{
  "name": "@notepadnext/plugin-sdk",
  "version": "0.3.0",
  "description": "Notepad Next ++ plugin SDK: types, contracts, templates, debugging and packaging",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "require": "./testing.cjs",
      "default": "./testing.cjs"
    },
    "./*.cjs": "./*.cjs",
    "./package.json": "./package.json",
    "./local-service": {
      "types": "./local-service.d.ts",
      "require": "./local-service.cjs",
      "default": "./local-service.cjs"
    },
    "./native": {
      "types": "./native.d.ts"
    }
  },
  "files": [
    "index.d.ts",
    "testing.cjs",
    "testing.d.ts",
    "create.cjs",
    "debug.cjs",
    "pack.cjs",
    "archive.cjs",
    "release.cjs",
    "import-vscode.cjs",
    "templates",
    "schemas",
    "docs",
    "README.md",
    "LICENSE",
    "local-service.cjs",
    "local-service.d.ts",
    "experimental",
    "native.d.ts"
  ],
  "bin": {
    "nnp-create": "create.cjs",
    "nnp-debug": "debug.cjs",
    "nnp-package": "pack.cjs",
    "nnp-archive": "archive.cjs",
    "nnp-release": "release.cjs",
    "nnp-import-vscode": "import-vscode.cjs"
  },
  "scripts": {
    "test": "node --test pack.test.cjs developer.test.cjs local-service.test.cjs importer.test.cjs",
    "test:standalone": "node tests/standalone.cjs build/standalone-validation",
    "release:kit": "node tools/release-sdk.cjs"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KMerdan/notepadnext-plugin-sdk.git"
  },
  "homepage": "https://github.com/KMerdan/notepadnext-plugin-sdk",
  "bugs": {
    "url": "https://github.com/KMerdan/notepadnext-plugin-sdk/issues"
  }
}
