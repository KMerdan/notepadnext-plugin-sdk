{
  "manifestVersion": 1,
  "id": "__PLUGIN_ID__",
  "name": "HTML Preview",
  "description": "Run HTML and JavaScript through an activation-owned local Node.js service.",
  "version": "0.1.0",
  "list": false,
  "engines": {
    "notepadnext": ">=0.15.2 <0.16.0",
    "api": "^0.3.0"
  },
  "runtime": {
    "kind": "node",
    "entry": "dist/index.js"
  },
  "capabilities": {
    "required": [
      "commands@1",
      "documents.read@1",
      "documents.events@1",
      "webviews@1",
      "webviews.service@1",
      "webviews.restore@1",
      "webviews.document@1"
    ],
    "optional": []
  },
  "activationEvents": [
    "onCommand:__PLUGIN_ID__.open"
  ],
  "contributes": {
    "commands": [
      {
        "id": "__PLUGIN_ID__.open",
        "title": "Open HTML Preview"
      }
    ],
    "menus": [
      {
        "location": "plugins",
        "command": "__PLUGIN_ID__.open",
        "order": 120
      }
    ]
  },
  "category": "editor-preview",
  "preview": {
    "viewType": "html-preview",
    "languages": [
      "html"
    ],
    "extensions": [
      ".html",
      ".htm"
    ]
  }
}
