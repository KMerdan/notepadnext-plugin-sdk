{
  "manifestVersion": 1,
  "id": "__PLUGIN_ID__",
  "name": "TODO Navigator",
  "version": "0.1.0",
  "list": false,
  "description": "Find TODO markers, highlight their native ranges and navigate results.",
  "engines": {
    "notepadnext": ">=0.15.2 <0.16.0",
    "api": "^0.3.0"
  },
  "runtime": {
    "kind": "node",
    "entry": "dist/index.js"
  },
  "capabilities": {
    "required": [
      "commands@1",
      "messages@1",
      "documents.read@1",
      "documents.native.events@1",
      "editors.selection.read@1",
      "editors.view.write@1",
      "webviews@1",
      "webviews.restore@1",
      "search.read@1",
      "decorations.write@1",
      "webviews.html@1"
    ],
    "optional": []
  },
  "activationEvents": [
    "onCommand:__PLUGIN_ID__.show"
  ],
  "contributes": {
    "commands": [
      {
        "id": "__PLUGIN_ID__.show",
        "title": "Open TODO Navigator",
        "icon": "dist/media/icon.png"
      }
    ],
    "menus": [
      {
        "location": "plugins",
        "command": "__PLUGIN_ID__.show",
        "order": 110
      }
    ]
  },
  "category": "editor-tool"
}
